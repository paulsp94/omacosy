#!/usr/bin/env bash
# omacosy-cycle [next|prev] — Alt+Tab for the focused WORKSPACE.
#
# macOS's own switcher is Cmd+Tab and switches APPS, so nothing reaches a
# third window on a workspace. AeroSpace has `focus dfs-next`, but it
# ignores `--boundaries workspace`: measured, cycling from a window on
# workspace 3 landed on Slack on workspace 4 and then Arc on workspace 1.
# So the walk is done here, over the windows aerospace says are on this
# workspace, and it cannot leave.
#
# Floating windows are included deliberately — this is the one switcher
# that reaches a float that has sunk behind the tiles. The cursor follows
# the focus for the same reason omacosy-float moves it: focus-follows-
# mouse would otherwise hand focus straight back to whatever the pointer
# was resting on.
set -uo pipefail

# The walk below is aerospace CLI end to end (window list, focus, mouse
# warp), and OmniWM brings its own local cycling — stand down.
# a live OmniWM answers its socket in ~3 ms; pgrep -f scanned every
# process for 31 ms per call, and a stale socket after a crash cannot
# fool a real request the way a file test could
wm_is_omniwm() { "$HOME/.local/bin/omacosy-omni" active >/dev/null 2>&1; }
wm_is_omniwm && exit 0

A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"
dir="${1:-next}"

WINS="$("$A" list-windows --workspace focused --format '%{window-id}' 2>/dev/null)"
[ -n "$WINS" ] || exit 0
CURRENT="$("$A" list-windows --focused --format '%{window-id}' 2>/dev/null || true)"

target="$(printf '%s\n' $WINS | awk -v cur="$CURRENT" -v dir="$dir" '
  { w[NR] = $0 }
  END {
    if (NR < 2) exit
    at = 0
    for (i = 1; i <= NR; i++) if (w[i] == cur) at = i
    if (at == 0) { print w[1]; exit }
    print (dir == "prev") ? (at == 1 ? w[NR] : w[at - 1]) : (at == NR ? w[1] : w[at + 1])
  }')"
[ -n "$target" ] || exit 0

"$A" focus --window-id "$target" || exit 0
"$A" move-mouse window-lazy-center >/dev/null 2>&1 || true
