#!/usr/bin/env bash
# Bounce workspace switches nobody asked for. macOS lets an app
# activate itself (WhatsApp on a message, Electron apps generally) and
# aerospace faithfully follows native focus — so the desktop yanks to
# that app's workspace mid-work. Hyprland solves this with
# focus_on_activate=false; this is the omacosy equivalent.
#
# Called from exec-on-workspace-change. A switch counts as user-driven
# when EITHER a deliberate CGEvent (key/click/scroll — via
# `omacosy-helper input-age`) or the swipe daemon's intent stamp (raw
# multitouch contacts emit no CGEvents) is ≤2s old. Anything else is
# an app self-activation: send the workspace straight back.

# This is aerospace's exec-on-workspace-change contract (env vars,
# bounce via its CLI); under OmniWM the hook never fires, but a
# straggler from the handover must stand down, not bounce.
# a live OmniWM answers its socket in ~3 ms; pgrep -f scanned every
# process for 31 ms per call, and a stale socket after a crash cannot
# fool a real request the way a file test could
wm_is_omniwm() { "$HOME/.local/bin/omacosy-omni" active >/dev/null 2>&1; }
wm_is_omniwm && exit 0

U=$(id -u)
BOUNCE="/tmp/omacosy-guard-bounce-$U"
INTENT="/tmp/omacosy-user-intent-$U"

# our own bounce landing — consume the marker instead of re-judging
# (would otherwise ping-pong forever)
if [ -f "$BOUNCE" ]; then
  TARGET=$(cat "$BOUNCE" 2>/dev/null)
  rm -f "$BOUNCE"
  [ "$TARGET" = "$AEROSPACE_FOCUSED_WORKSPACE" ] && exit 0
fi

[ -n "$AEROSPACE_PREV_WORKSPACE" ] || exit 0

# one bounce per 3s window: aerospace can deliver hooks for rapid
# switches out of order, so a marker mismatch must not let two guard
# instances ping-pong the desktop between workspaces
COOLDOWN="/tmp/omacosy-guard-cooldown-$U"
if [ -f "$COOLDOWN" ]; then
  CAGE=$(($(date +%s) - $(stat -f %m "$COOLDOWN")))
  [ "$CAGE" -le 3 ] && exit 0
fi

if [ -f "$INTENT" ]; then
  AGE=$(($(date +%s) - $(stat -f %m "$INTENT")))
  [ "$AGE" -le 2 ] && exit 0
fi

IN_AGE=$("$HOME/.local/bin/omacosy-helper" input-age 2>/dev/null)
# missing/garbled reading → stand down; never bounce on no data
case "$IN_AGE" in '' | *[!0-9.]*) exit 0 ;; esac
awk -v a="$IN_AGE" 'BEGIN{exit !(a <= 2.0)}' && exit 0

echo "$(date '+%F %T') bounced $AEROSPACE_FOCUSED_WORKSPACE -> $AEROSPACE_PREV_WORKSPACE (input ${IN_AGE}s ago)" >>/tmp/omacosy-focus-guard.log
touch "$COOLDOWN"
printf '%s' "$AEROSPACE_PREV_WORKSPACE" >"$BOUNCE"
exec /opt/homebrew/bin/aerospace workspace "$AEROSPACE_PREV_WORKSPACE"
