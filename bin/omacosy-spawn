#!/bin/bash
# omacosy-spawn <App> — open a new window of App, serialized so the
# dwindle split hint keeps up.
#
# The split hint runs AFTER a window exists (on-focus-changed), so two
# windows created at the same instant both land before any hint can
# shape them — spamming Super+Enter used to produce a flat pile. No
# post-hoc hint can win that race; the fix is on this side: take a
# lock, open ONE window, and wait until omacosy-helper split-hint has
# stamped it into the state file (its first field is the newest hinted
# window id, and ids only grow) before letting the next spawn go.
# Spam then becomes a rapid, clean sequence instead of a simultaneous
# mess. Worst case the wait gives up after 2s so a broken hint chain
# can never wedge the terminal key.
APP="$1"
[ -n "$APP" ] || exit 1

# A new Ghostty window can come from the instance that is already
# running. `open -na` is a whole second app instance every time, a full
# app launch, while Ghostty 1.3's scripting dictionary hands a window
# over from the one already warm. Time from the key to a window the WM
# can see: ~140 ms against ~300 ms on the author's Mac; ~225 ms against
# ~810 ms measured here through OmniWM's window count. The instance
# count is the other half — three spawns through open(1) left three more
# ghostty processes behind, the dictionary path none. Ghostty is the
# terminal this repo ships and Super+Enter is the most pressed chord in
# the map, so it earns the special case.
#
# Everything else, and a Ghostty that is not running yet, goes through
# open(1): addressing an app that is down would launch it AND let it
# open its own initial window, which is two windows for one press.
# Ghostty before 1.3 has no dictionary and raises, landing there too.
# The directory is pinned to $HOME because that is where open(1) starts
# one; inheriting the focused window's directory would be a behaviour
# change riding along with a speed-up.
# The name is matched literally, so a renamed Ghostty bundle simply
# takes the open(1) path — slower, never wrong.
#
# `with timeout` because this runs while the spawn lock is HELD: an
# Apple event to a wedged app waits two minutes by default, which would
# take the terminal key down with it. Five seconds, then the error lands
# in the same fallback as a missing dictionary.
spawn_app() {
  if [ "$1" = Ghostty ] && /usr/bin/osascript \
    -e 'if application "Ghostty" is running then' \
    -e 'with timeout of 5 seconds' \
    -e "tell application \"Ghostty\" to new window with configuration {initial working directory:\"$HOME\"}" \
    -e 'end timeout' \
    -e 'else' \
    -e 'error "Ghostty is not running"' \
    -e 'end if' >/dev/null 2>&1; then
    return 0
  fi
  open -na "$1"
}

# macOS ships no flock; mkdir is the portable atomic lock. Both WM
# paths need the same serialization, so it is taken ONCE here.
#
# The holder writes its pid inside, because a spawn really does get
# killed outright: Karabiner runs one shell_command at a time and
# SIGKILLs the one still running when the next key arrives. SIGKILL
# runs no EXIT trap, so a lock without an owner recorded in it outlives
# the process that took it, and every later press then waits on
# something that is already gone. A waiter that finds a dead holder
# clears the lock immediately instead. The pid lands just after the
# mkdir, so an empty one is re-read after a beat before it counts.
#
# The give-up timer is wall clock. The old one counted 120 sleeps of
# 0.05 and called that 5 s; a turn really costs ~130 ms, so it did not
# fire until 13 s. It also fell through and ran WITHOUT the lock while
# its trap still removed whatever lock it found, including one another
# spawn was holding. Releasing is now owner-checked, so falling through
# is harmless.
LOCK="/tmp/omacosy-spawn-$(id -u).lock.d"
read_owner() { owner=""; [ -r "$LOCK/pid" ] && read -r owner < "$LOCK/pid"; }
trap 'read_owner; [ "$owner" = "$$" ] && rm -rf "$LOCK"' EXIT
give_up=$(( SECONDS + 8 ))
turns=0
while :; do
  mkdir "$LOCK" 2>/dev/null && { echo $$ > "$LOCK/pid"; break; }
  read_owner
  [ -z "$owner" ] && { sleep 0.05; read_owner; }
  stale=no
  case "$owner" in
    ""|*[!0-9]*) stale=yes ;;
    *) kill -0 "$owner" 2>/dev/null || stale=yes ;;
  esac
  [ "$SECONDS" -ge "$give_up" ] && stale=yes
  [ "$stale" = yes ] && { rm -rf "$LOCK"; continue; }
  turns=$(( turns + 1 ))
  [ "$turns" -gt 400 ] && break   # never wedge the key: go on unlocked
  sleep 0.05
done

# Under OmniWM the split is native, but its insertion side is not
# omarchy's: with smartSplit off a new window goes RIGHT in horizontal
# splits and ABOVE in vertical ones (frames are y-up; "second child"
# lands at the top), while Hyprland's force_split=2 is right/below —
# so the spiral never read as the omarchy staircase. OmniWM's one-shot
# `preselect <dir>` fixes the side per spawn: apply its own
# orientation rule (height * splitWidthMultiplier > width -> vertical)
# to the focused tile and preselect down/right. No state, no
# prediction — one query and one command, through a sanctioned API.
# Spawns are still serialized (lock + wait for the window to appear)
# so a burst becomes a clean staircase instead of splitting the same
# cell over and over.
# a live OmniWM answers its socket in ~3 ms; pgrep -f scanned every
# process for 31 ms per call, and a stale socket after a crash cannot
# fool a real request the way a file test could
wm_is_omniwm() { "$HOME/.local/bin/omacosy-omni" active >/dev/null 2>&1; }
if wm_is_omniwm; then
  OMNI="$HOME/.local/bin/omacosy-omni"
  mult="$(sed -n 's/^splitWidthMultiplier = //p' "$HOME/.config/omniwm/settings.toml" 2>/dev/null | head -1)"
  "$OMNI" preselect-for-focused "${mult:-1.4}" >/dev/null 2>&1 || true
  before="$("$OMNI" window-count 2>/dev/null || echo 0)"
  # the next spawn may go once this window exists: a windows-changed
  # subscription says so the moment it does. Subscribed BEFORE the
  # open — `open -na` can block until the app is up, and a window that
  # registered before the subscription would never be seen (measured:
  # one spawn in three hit the cap that way). 2 s cap so a launch that
  # never shows a window cannot wedge the terminal key.
  "$OMNI" wait-window "$before" 2000 >/dev/null 2>&1 &
  waiter=$!
  spawn_app "$APP"
  wait "$waiter" 2>/dev/null || true
  exit 0
fi

STATE="/tmp/omacosy-split-state-$(id -u)"


prev=0
[ -f "$STATE" ] && prev=$(cut -d' ' -f1 "$STATE")
spawn_app "$APP"
for _ in $(seq 40); do
  cur=0
  [ -f "$STATE" ] && cur=$(cut -d' ' -f1 "$STATE")
  [ "${cur%.*}" -gt "${prev%.*}" ] 2>/dev/null && exit 0
  sleep 0.05
done
