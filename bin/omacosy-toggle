#!/usr/bin/env bash
# omacosy-toggle [on|off|toggle] — park the whole tiling setup without
# uninstalling. `off`: the window manager stops managing (AeroSpace's
# keybindings go quiet; OmniWM quits — it has no enable toggle), the
# hover-focus, borders and trackpad-swipe daemons stop, the bar stops.
# `on` restores all of it, for the window manager this Mac uses (the
# rule install.sh uses). No args = flip.
#
# Untouched either way: Karabiner's CapsLock=Super remap (harmless
# while AeroSpace is off) and the native menu bar's auto-hide default
# (the native menu bar is there once the bar is down).
set -euo pipefail

STATE="$HOME/.config/omacosy/disabled"
UID_N="$(id -u)"
AGENTS=(com.omacosy.ffm com.omacosy.borders com.omacosy.dwindle com.omacosy.bar com.omacosy.gesture com.omacosy.recall)

# the window manager this Mac uses, by the same rule as install.sh. The
# login item stays while OmniWM is down or restarting, so a manager that
# does not answer at this moment cannot turn the answer into aerospace.
wm_is_omniwm() {
  [ -d /Applications/OmniWM.app ] || return 1
  "$HOME/.local/bin/omacosy-omni" active >/dev/null 2>&1 \
    || osascript -e 'tell application "System Events" to exists login item "OmniWM"' 2>/dev/null | grep -qx true
}

mode="${1:-toggle}"
if [ "$mode" = toggle ]; then
  if [ -e "$STATE" ]; then mode=on; else mode=off; fi
fi

case "$mode" in
  off)
    if wm_is_omniwm; then
      wm=omniwm
      osascript -e 'quit app "OmniWM"' 2>/dev/null || true
      pkill -x OmniWM 2>/dev/null || true
    else
      wm=aerospace
      aerospace enable off 2>/dev/null || true
    fi
    for a in "${AGENTS[@]}"; do
      launchctl bootout "gui/$UID_N/$a" 2>/dev/null || true
    done
    mkdir -p "$(dirname "$STATE")" && printf '%s\n' "$wm" >"$STATE"
    echo "omacosy: OFF — vanilla macOS. Restore with: omacosy-toggle on"
    ;;
  on)
    # on brings back what install.sh runs for this manager
    if wm_is_omniwm; then wm=omniwm; else wm=aerospace; fi
    for a in "${AGENTS[@]}"; do
      # ffm fights OmniWM's own focus-follows-mouse, so install.sh and
      # omacosy-wm-switch keep it parked under OmniWM
      if [ "$wm" = omniwm ] && [ "$a" = com.omacosy.ffm ]; then continue; fi
      # recall answers an OmniWM behaviour: load it only under OmniWM
      if [ "$wm" != omniwm ] && [ "$a" = com.omacosy.recall ]; then continue; fi
      launchctl bootstrap "gui/$UID_N" "$HOME/Library/LaunchAgents/$a.plist" 2>/dev/null || true
    done
    if [ "$wm" = omniwm ]; then
      open -a OmniWM 2>/dev/null || true
    elif pgrep -x AeroSpace >/dev/null; then
      aerospace enable on 2>/dev/null || true
    else
      open -a AeroSpace 2>/dev/null || true
    fi
    rm -f "$STATE"
    echo "omacosy: ON — tiling restored"
    ;;
  *)
    echo "usage: omacosy-toggle [on|off|toggle]" >&2
    exit 2
    ;;
esac
