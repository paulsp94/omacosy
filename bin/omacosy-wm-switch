#!/usr/bin/env bash
# omacosy-wm-switch <omniwm|aerospace> — move this machine between
# window managers WITHOUT ever leaving it unnavigable.
#
# The 2026-08-25 lesson: the WM is the tool you recover WITH. The first
# OmniWM switch quit AeroSpace before OmniWM's permissions were
# granted, and the user was stranded on one workspace with no keys, no
# swipes and no terminal. So this script refuses to be clever:
#
#   1. SNAPSHOT the window->workspace map first (the switch scrambles
#      it; the way back restores it).
#   2. Start the NEW manager alongside the old one. OmniWM stays
#      passive until Accessibility is granted, so nothing fights.
#   3. Only after you confirm the grant does the old manager stop.
#   4. DEAD-MAN GATE: you must type `yes` within 90 seconds to confirm
#      workspace switching actually works. Anything else — timeout,
#      typo, panic — reverts to the old manager automatically.
set -uo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"
STATE_DIR="$HOME/.local/state/omacosy"
SNAP="$STATE_DIR/wm-switch-snapshot"
mkdir -p "$STATE_DIR"

snapshot() {
  "$A" list-windows --all --format '%{window-id}|%{workspace}|%{app-name}' \
    > "$SNAP" 2>/dev/null && log "Snapshot: $(wc -l < "$SNAP" | tr -d ' ') windows recorded"
}

restore_snapshot() {
  [ -s "$SNAP" ] || return 0
  log "Restoring window->workspace map"
  while IFS='|' read -r wid ws _; do
    [ -n "$wid" ] && "$A" move-node-to-workspace --window-id "$wid" "$ws" 2>/dev/null
  done < "$SNAP"
}

start_aerospace_world() {
  open -a AeroSpace
  sleep 1
  "$A" reload-config 2>/dev/null || true
  # restore the full swipe config (workspace steps + overview)
  REPO="$(cd "$(dirname "$(readlink "$HOME/.local/bin/omacosy-wm-switch" || echo "$0")")/.." && pwd)"
  cp "$REPO/config/gesture/config.json" "$HOME/.config/omacosy/gesture.json" 2>/dev/null || true
  launchctl load "$HOME/Library/LaunchAgents/com.omacosy.ffm.plist" 2>/dev/null || true
  launchctl load "$HOME/Library/LaunchAgents/com.omacosy.gesture.plist" 2>/dev/null || true
}

stop_aerospace_world() {
  # ffm and omacosy-gesture are AeroSpace-coupled (SLPS focus fights
  # OmniWM's native ffm; swipe talks to a dead socket) — park them
  launchctl bootout "gui/$(id -u)/com.omacosy.ffm" 2>/dev/null || true
  launchctl bootout "gui/$(id -u)/com.omacosy.gesture" 2>/dev/null || true
  osascript -e 'quit app "AeroSpace"' 2>/dev/null || true
}

case "${1:-}" in
omniwm)
  # the OmniWM option installs itself on first use — the default
  # install stays AeroSpace-only and nobody downloads a second WM
  # they never switch to
  if [ ! -d /Applications/OmniWM.app ]; then
    log "Installing OmniWM (first use of the omniwm option)"
    brew trust BarutSRB/tap 2>/dev/null || true
    brew install --cask BarutSRB/tap/omniwm || { log "install failed"; exit 1; }
  fi
  snapshot
  log "Starting OmniWM ALONGSIDE AeroSpace (it stays passive until granted)"
  open -a OmniWM
  echo
  echo "  Grant OmniWM in System Settings -> Privacy & Security:"
  echo "    - Accessibility        (required — nothing works without it)"
  echo "    - Input Monitoring     (workspace swipes)"
  echo
  # read from the terminal itself, not stdin — run through Claude Code's
  # `!` prefix (or any pipe) stdin is EOF and both gates would blow
  # through instantly, turning the switch into a pointless bounce
  read -r -p "  Press Enter AFTER both grants are done (Ctrl-C aborts, nothing changed): " < /dev/tty
  log "Handing over: stopping AeroSpace, ffm and swipe"
  stop_aerospace_world
  # OmniWM refuses to start while another WM runs — it sits in a
  # "Conflicting Window Managers" dialog and does NOT re-check on its
  # own. Give AeroSpace a moment to die, then relaunch OmniWM: a fresh
  # activation re-runs the conflict check and it starts managing.
  sleep 2
  open -a OmniWM
  sleep 2
  # the exec chords (terminal, launcher, theme, lock, ...) lived in
  # aerospace.toml — OmniWM's hotkeys cannot exec, so they move into
  # Karabiner rules for the duration
  "$HOME/.local/bin/omacosy-karabiner-omniwm" install 2>/dev/null || true
  # omacosy-gesture comes BACK, demoted to the vertical gesture only:
  # OmniWM's own swipes are horizontal-only (one axis), and swipe-up
  # for the overview is muscle memory. Its horizontal actions are set
  # to "" (non-next/prev strings no-op before any aerospace call), so
  # it cannot fight OmniWM's workspace swipes. swipe_down stays "" too:
  # OmniWM rejects ALL IPC while its overview is open, so a close
  # gesture cannot work — Esc, click or selecting closes it.
  REPO="$(cd "$(dirname "$(readlink "$HOME/.local/bin/omacosy-wm-switch" || echo "$0")")/.." && pwd)"
  cp "$REPO/config/gesture/config.omniwm.json" "$HOME/.config/omacosy/gesture.json" 2>/dev/null || true
  launchctl load "$HOME/Library/LaunchAgents/com.omacosy.gesture.plist" 2>/dev/null || true
  echo
  echo "  VERIFY NOW: switch workspaces with Super+1 and Super+2."
  echo "  Type 'yes' within 90 seconds if it works."
  echo "  Anything else reverts to AeroSpace automatically."
  echo
  CONFIRM=""
  read -r -t 90 -p "  working? " CONFIRM < /dev/tty || true
  if [ "$CONFIRM" = "yes" ]; then
    log "Switch confirmed. OmniWM is your window manager."
    # ...including at LOGIN: the first reboot of the OmniWM era booted
    # straight back into AeroSpace because only the login item decides
    # who owns the session at boot — the switch has to move it too
    osascript -e 'tell application "System Events"
      if exists login item "AeroSpace" then delete login item "AeroSpace"
      if not (exists login item "OmniWM") then make new login item at end with properties {path:"/Applications/OmniWM.app", hidden:false}
    end tell' 2>/dev/null || true
    log "Way back any time: omacosy-wm-switch aerospace"
  else
    log "No confirmation — REVERTING to AeroSpace"
    "$HOME/.local/bin/omacosy-karabiner-omniwm" remove 2>/dev/null || true
    osascript -e 'quit app "OmniWM"' 2>/dev/null || true
    pkill -f OmniWM.app 2>/dev/null || true
    start_aerospace_world
    sleep 2
    restore_snapshot
    log "Back on AeroSpace, windows restored."
  fi
  ;;
aerospace)
  log "Stopping OmniWM, starting the AeroSpace world"
  osascript -e 'tell application "System Events"
    if exists login item "OmniWM" then delete login item "OmniWM"
    if not (exists login item "AeroSpace") then make new login item at end with properties {path:"/Applications/AeroSpace.app", hidden:false}
  end tell' 2>/dev/null || true
  "$HOME/.local/bin/omacosy-karabiner-omniwm" remove 2>/dev/null || true
  osascript -e 'quit app "OmniWM"' 2>/dev/null || true
  pkill -f OmniWM.app 2>/dev/null || true
  start_aerospace_world
  sleep 2
  restore_snapshot
  log "Back on AeroSpace."
  ;;
*)
  echo "usage: omacosy-wm-switch <omniwm|aerospace>" >&2
  exit 1
  ;;
esac
