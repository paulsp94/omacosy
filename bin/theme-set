#!/usr/bin/env bash
# theme-set <name> — switch the whole desktop theme in one move.
# Swaps ~/.config/omarchy/current/theme (the omarchy convention), then
# nudges every consumer: Korren live-reloads on its own (it watches the
# omarchy dir), the bar and borders both watch the theme and restyle
# in place — nothing here has to tell them.

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"
CURRENT_DIR="$HOME/.config/omarchy/current"

case "${1:-list}" in
  list)
    for t in "$THEMES_DIR"/*/; do basename "$t"; done
    exit 0
    ;;
esac

NAME="$1"
if [ ! -d "$THEMES_DIR/$NAME" ]; then
  echo "theme-set: unknown theme '$NAME'. Available:" >&2
  for t in "$THEMES_DIR"/*/; do basename "$t"; done >&2
  exit 1
fi

mkdir -p "$CURRENT_DIR"
ln -sfn "$THEMES_DIR/$NAME" "$CURRENT_DIR/theme"

# Korren: prefer its hand-tuned built-in theme when one matches; fall
# back to live-deriving from the omarchy palette. Korren watches its
# config file, so this repaints immediately.
KORREN_CFG="$HOME/Library/Application Support/korren/config.toml"
case "$NAME" in
  tokyo-night|catppuccin|gruvbox|solarized-dark|osaka-jade|daylight) korren_theme="$NAME" ;;
  *) korren_theme="omarchy" ;;
esac
if [ -f "$KORREN_CFG" ]; then
  sed -i '' "s/^name = \".*\"/name = \"$korren_theme\"/" "$KORREN_CFG"
fi

# Wallpaper: first image in the theme's backgrounds/ dir, on every screen.
# omacosy-helper wraps NSWorkspace and verifies the set with a per-screen
# read-back — on macOS 26+ the API returns success while silently keeping
# the old picture — falling back to System Events desktop scripting, the
# path that still lands. If even that fails the helper exits non-zero and
# osascript runs here as the last resort.
WALL="$(ls "$THEMES_DIR/$NAME"/backgrounds/* 2>/dev/null | head -1)"
if [ -n "$WALL" ]; then
  # theme-bg-next cycles through the rest; a theme switch restarts the
  # cycle at the first image, so the remembered position moves with it
  mkdir -p "$HOME/.local/state/omacosy"
  ln -nsf "$WALL" "$HOME/.local/state/omacosy/background"
  helper_ok=0
  if [ -x "$HOME/.local/bin/omacosy-helper" ]; then
    "$HOME/.local/bin/omacosy-helper" wallpaper "$WALL" >/dev/null 2>&1 && helper_ok=1
  fi
  if [ "$helper_ok" -eq 0 ]; then
    # the path is an ARGUMENT, not spliced into the script text: it is a
    # filename out of a theme pack, and a theme is third-party content.
    # A wallpaper named  x" & (do shell script "...") & ".jpg  would
    # otherwise close the AppleScript string and run.
    osascript - "$WALL" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
  fi
fi


# omacosy-bar and omacosy-borders both re-read the theme on their own
# (kqueue on ~/.config/omarchy/current), so the symlink swap above IS
# the notification

# OmniWM draws the focus border while it is the window manager (our
# ring clips at screen edges there — no outer gaps). Its color lives in
# settings.toml as 0-1 floats; write the theme's ACTIVE_COLOR
# (0xAARRGGBB) into it — OmniWM live-reloads, so this recolors at once.
OMNIWM_SETTINGS="$HOME/.config/omniwm/settings.toml"
if [ -f "$OMNIWM_SETTINGS" ] && [ -f "$THEMES_DIR/$NAME/borders.sh" ]; then
  ACTIVE="$(grep -o 'ACTIVE_COLOR=0x[0-9a-fA-F]*' "$THEMES_DIR/$NAME/borders.sh" | head -1 | cut -d= -f2)"
  if [ -n "$ACTIVE" ]; then
    python3 - "$OMNIWM_SETTINGS" "$ACTIVE" <<'PY'
import re, sys
path, argb = sys.argv[1], sys.argv[2]
v = int(argb, 16)
r, g, b = (v >> 16 & 0xFF) / 255, (v >> 8 & 0xFF) / 255, (v & 0xFF) / 255
t = open(path).read()
sec = re.search(r'\[borders\.color\]\n(?:[a-z]+ = [0-9.]+\n)+', t)
if sec:
    new = f"[borders.color]\nalpha = 1.0\nblue = {b}\ngreen = {g}\nred = {r}\n"
    t = t[:sec.start()] + new + t[sec.end():]
    open(path, 'w').write(t)
PY
  fi
fi

echo "theme: $NAME"
