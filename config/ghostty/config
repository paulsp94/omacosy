# Ghostty settings for the omacosy look. Loaded from ~/.config/ghostty
# (symlinked by install.sh); your personal settings can live in
# ~/Library/Application Support/com.mitchellh.ghostty/config — Ghostty
# reads both.

# No titlebar, no traffic lights — the Hyprland look. Close is Super+W,
# moving is Super+Shift+arrows, so nothing the bar provided is lost.
macos-titlebar-style = hidden

# Pin the initial size of NEW windows (in cells). Ghostty otherwise
# inherits the previous window's size, and under a tiling WM that is
# usually the full screen — so every spawn played its open animation at
# full size over the whole layout before AeroSpace tiled it. Small and
# fixed, the pre-tile moment is a brief unobtrusive window instead.
window-width = 100
window-height = 30

# Super+Enter asks the running instance for the window, so the windows
# share one process and only a cold start goes through `open -na`.
# Without this, closing the last one leaves a windowless instance running
# forever — and back when every window was its own `open -na` instance,
# that meant ten stale ghostty processes after a day's work.
quit-after-last-window-closed = true
